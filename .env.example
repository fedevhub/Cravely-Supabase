PORT=3000
SESSION_SECRET=ganti-dengan-secret-kamu

# Supabase -> Project Settings -> API. Backend membutuhkan service-role/secret key,
# bukan publishable key; jangan pernah mengekspos key ini ke browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-atau-secret-key

# Opsional (notifikasi WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
ADMIN_WHATSAPP_NUMBER=
